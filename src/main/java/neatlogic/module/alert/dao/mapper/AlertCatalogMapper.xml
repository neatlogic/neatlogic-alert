<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="neatlogic.module.alert.dao.mapper.AlertCatalogMapper">
    <resultMap id="alertCatalogResultMap" type="neatlogic.framework.alert.dto.AlertCatalogVo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="fcu" property="fcu"/>
        <result column="fcd" property="fcd"/>
        <result column="lcu" property="lcu"/>
        <result column="sort" property="sort"/>
        <result column="isActive" property="isActive"/>
        <collection property="alertCatalogAuthList" ofType="neatlogic.framework.alert.dto.AlertCatalogAuthVo">
            <id column="authUuid" property="authUuid"/>
            <id column="authType" property="authType"/>
            <id column="catalogId" property="catalogId"/>
        </collection>
    </resultMap>

    <select id="getAlertCatalogById" parameterType="java.lang.Long" resultMap="alertCatalogResultMap">
        select a.id,
               a.name,
               a.is_active  as isActive,
               a.sort       as sort,
               b.catalog_id as catalogId,
               b.auth_type  as authType,
               b.auth_uuid  as authUuid
        from alert_catalog a
                 left join alert_catalog_auth b on a.id = b.catalog_id
        where a.id = #{value}
    </select>

    <select id="checkAlertCatalogIsExists" parameterType="neatlogic.framework.alert.dto.AlertCatalogVo"
            resultType="int">
        select count(1)
        from alert_catalog
        where name = #{name}
          and id != #{id}
    </select>

    <sql id="searchAlertCatalogSql">
        <where>
            <if test="isActive != null">
                and is_active = #{isActive}
            </if>
            <if test="keyword != null and keyword != ''">
                and a.name like CONCAT(#{keyword}, '%')
            </if>
            <if test="!isAdmin">
                and (
                (b.auth_type = 'common' and b.auth_uuid = 'alluser')
                <if test="userId != null and userId != ''">
                    or (b.auth_type = 'user' and b.auth_uuid = #{userId})
                </if>
                <if test="teamUuidList != null and teamUuidList.size() > 0">
                    or (b.auth_type = 'team' and b.auth_uuid in
                    <foreach collection="teamUuidList" open="(" close=")" separator="," item="item">#{item}</foreach>)
                </if>
                <if test="roleUuidList != null and roleUuidList.size() > 0">
                    or (b.auth_type = 'role' and b.auth_uuid in
                    <foreach collection="roleUuidList" open="(" close=")" separator="," item="item">#{item}</foreach>)
                </if>
                )
            </if>
        </where>
    </sql>

    <select id="searchAlertCatalogCount" parameterType="neatlogic.framework.alert.dto.AlertCatalogVo" resultType="int">
        select
        count(distinct a.id)
        from alert_catalog a
        left join alert_catalog_auth b on a.id = b.catalog_id
        <include refid="searchAlertCatalogSql"></include>
    </select>

    <select id="listAlertCatalog" parameterType="neatlogic.framework.alert.dto.AlertCatalogVo"
            resultMap="alertCatalogResultMap">
        select
        a.id,
        a.name,
        a.fcu,
        a.fcd,
        a.lcu,
        a.lcd,
        a.sort,
        a.is_active as isActive,
        b.catalog_id as catalogId,
        b.auth_type as authType,
        b.auth_uuid as authUuid
        from alert_catalog a
        left join alert_catalog_auth b on a.id = b.catalog_id
        <include refid="searchAlertCatalogSql"></include>
        order by a.sort
    </select>

    <select id="searchAlertCatalog" parameterType="neatlogic.framework.alert.dto.AlertCatalogVo"
            resultType="neatlogic.framework.alert.dto.AlertCatalogVo">
        select
        a.id,
        a.name,
        a.fcu,
        a.fcd,
        a.lcu,
        a.lcd,
        a.sort,
        a.is_active as isActive
        from alert_catalog a join (
        select
        distinct
        a.id,a.sort
        from alert_catalog a
        left join alert_catalog_auth b on a.id = b.catalog_id
        <include refid="searchAlertCatalogSql"></include>
        order by a.sort
        limit #{startNum}, #{pageSize}) tmp on a.id = tmp.id
        order by a.sort
    </select>

    <select id="checkAlertCatalogIsInUsed" parameterType="java.lang.Long" resultType="int">
        select count(1)
        from alert_view
        where catalog_id = #{value}
    </select>

    <insert id="saveAlertCatalog" parameterType="neatlogic.framework.alert.dto.AlertCatalogVo">
        insert into alert_catalog
        (id,
         name,
         is_active,
         sort,
         fcd,
         fcu)
        values (#{id},
                #{name},
                #{isActive},
                #{sort},
                now(),
                #{fcu})
        ON DUPLICATE KEY UPDATE name      = #{name},
                                is_active = #{isActive},
                                lcu       = #{lcu},
                                lcd       = now()
    </insert>

    <insert id="insertAlertCatalogAuth" parameterType="neatlogic.framework.alert.dto.AlertCatalogAuthVo">
        insert into alert_catalog_auth
        (catalog_id,
         auth_type,
         auth_uuid)
        values (#{catalogId},
                #{authType},
                #{authUuid})
    </insert>

    <update id="updateAlertCatalogSort" parameterType="neatlogic.framework.alert.dto.AlertCatalogVo">
        update alert_catalog
        set sort = #{sort}
        where id = #{id}
    </update>


    <delete id="deleteAlertCatalogAuthByCatalogId" parameterType="java.lang.Long">
        delete
        from alert_catalog_auth
        where catalog_id = #{value}
    </delete>

    <delete id="deleteAlertCatalogById" parameterType="java.lang.Long">
        delete a,b
        from alert_catalog a
                 left join alert_catalog_auth b on a.id = b.catalog_id
        where a.id = #{value}
    </delete>
</mapper>
