{
  "moduleId": "alert",
  "name": "alert_catalog",
  "label": "告警catalog表",
  "description": "告警catalog表，属于告警模块的数据表。 可用于告警相关的启用状态筛选、时间维度统计、关联查询等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "主键ID，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(255)",
      "description": "名称。"
    },
    {
      "name": "parent_id",
      "type": "bigint",
      "description": "父目录id，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "is_active",
      "type": "tinyint",
      "description": "是否激活。"
    },
    {
      "name": "sort",
      "type": "int",
      "description": "排序。"
    },
    {
      "name": "fcd",
      "type": "timestamp",
      "description": "创建时间。"
    },
    {
      "name": "fcu",
      "type": "char(32)",
      "description": "创建人。"
    },
    {
      "name": "lcd",
      "type": "timestamp",
      "description": "修改时间。"
    },
    {
      "name": "lcu",
      "type": "char(32)",
      "description": "修改人。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "idx_parent_id",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "parent_id"
      ],
      "description": "普通索引，覆盖 parent_id 字段，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "idx_parent_id_sort",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "parent_id",
        "sort"
      ],
      "description": "普通索引，覆盖 parent_id、sort 字段，适合用于过滤、关联或排序查询。"
    }
  ]
}
