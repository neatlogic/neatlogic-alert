<?xml version="1.0" encoding="UTF-8"?>


<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="neatlogic.module.alert.dao.mapper.AlertStatusMapper">
    <select id="getAlertStatusCount" resultType="java.lang.Integer">
        select count(1)
        from alert_status
    </select>

    <select id="getStatusByName" parameterType="java.lang.String" resultType="neatlogic.framework.alert.dto.AlertStatusVo">
        select name,
               label,
               color,
               sort
        from alert_status
        where name = #{value}
    </select>

    <select id="getAllStatus" resultType="neatlogic.framework.alert.dto.AlertStatusVo">
        select name,
               label,
               color,
               sort
        from alert_status
        order by sort
    </select>

    <update id="updateAlertStatusSort" parameterType="neatlogic.framework.alert.dto.AlertStatusVo">
        update alert_status
        set sort = #{sort}
        where name = #{name}
    </update>

    <update id="updateAlertStatus" parameterType="neatlogic.framework.alert.dto.AlertStatusVo">
        update alert_status
        set label = #{label},
            color = #{color}
        where name = #{name}
    </update>

    <insert id="insertAlertStatus" parameterType="neatlogic.framework.alert.dto.AlertStatusVo">
        insert into alert_status
        (name,
         label,
         color,
         sort)
        values (#{name},
                #{label},
                #{color},
                #{sort})
    </insert>

    <delete id="deleteAlertStatus" parameterType="java.lang.String">
        delete
        from alert_status
        where name = #{value}
    </delete>
</mapper>
